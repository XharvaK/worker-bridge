{
  "name": "worker-bridge",
  "version": "2.0.0",
  "description": "Platform-agnostic headless AI worker bridge connecting Sol/Doc to Antigravity and OpenCode via GitHub mailbox",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "worker-bridge": "dist/index.js",
    "gemini-worker-bridge": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js start",
    "test": "vitest run --root . --exclude test/integration/real-smoke.test.ts",
    "test:real-smoke": "vitest run --root . test/integration/real-smoke.test.ts",
    "test:watch": "vitest --root ."
  },
  "keywords": [
    "antigravity",
    "opencode",
    "gemini",
    "worker",
    "bridge",
    "chatgpt",
    "sol"
  ],
  "author": "Xharv",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
